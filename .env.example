# Base URL of the users/readings backend (json-server in local dev).
# Copy this file to .env for local development, and set the same variable
# in your hosting provider's dashboard (Vercel/Netlify/etc.) for production,
# pointing to a publicly reachable backend — localhost:3000 only exists on
# a developer's own machine, so it can never work for site visitors.
VITE_API_URL=http://localhost:3000
